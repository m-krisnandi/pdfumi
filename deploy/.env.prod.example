# ========================================================
# PDFUMI PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Domain / TLS (Caddy Automatic HTTPS)
ACME_EMAIL=admin@pdfumi.com

# 2. Database (PostgreSQL)
POSTGRES_DB=pdfumi
POSTGRES_USER=pdfumi
POSTGRES_PASSWORD=GantiPasswordIniDenganYangSangatKuatDanPanjang123!

# 3. App Core
PDFUMI_PUBLIC_WEB_BASE=https://pdfumi.com
PDFUMI_CORS_ORIGINS=https://pdfumi.com,https://www.pdfumi.com
NEXT_PUBLIC_API_BASE=https://api.pdfumi.com
PDFUMI_SWAGGER_ENABLED=false
PDFUMI_ACTUATOR_USER=actuator
PDFUMI_ACTUATOR_PASSWORD=GantiPasswordActuatorKuat123!

# 4. Transactional Mail / SMTP (Resend, Brevo, AWS SES, atau Mailgun)
# Contoh Brevo (Gratis 300 email/hari):
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=email-kamu@domain.com
# SPRING_MAIL_PASSWORD=master-smtp-key
# PDFUMI_MAIL_FROM=Pdfumi <noreply@pdfumi.com>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
PDFUMI_MAIL_FROM=noreply@pdfumi.com

# 5. Midtrans Payments (QRIS, Kartu Kredit Internasional, Virtual Account, GoPay)
MIDTRANS_MERCHANT_ID=G602958288
MIDTRANS_CLIENT_KEY=Mid-client-NodxyD2VH9YGJmZu
MIDTRANS_SERVER_KEY=Mid-server-your-server-key-here
MIDTRANS_MODE=production

# 6. Indonesian QRIS Payments (Tripay - tripay.co.id)
# Daftar di https://tripay.co.id (Pendaftaran akun perorangan instan dengan KTP saja)
# Mode: "sandbox" untuk testing, "production" untuk menerima pembayaran live rupiah
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_MODE=production
TRIPAY_PRICE_PASS_IDR=19000
TRIPAY_PRICE_PRO_IDR=29000
TRIPAY_PRICE_BUSINESS_IDR=149000
