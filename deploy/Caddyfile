# API Backend Pdfumi (Spring Boot + PostgreSQL + LibreOffice)
api.pdfumi.com {
	encode zstd gzip

	request_body {
		max_size 100MB
	}

	reverse_proxy api:8080 {
		transport http {
			response_header_timeout 120s
		}
	}
}

